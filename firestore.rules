rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // Users Collection
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt'])
        && data.email is string && data.email.size() <= 255
        && (data.get('name', '') is string && data.get('name', '').size() <= 100)
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId)
        && isValidUser(incoming())
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidId(userId)
        && isValidUser(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email']);
    }

    // Purchases Subcollection
    function isValidPurchase(data) {
      return data.keys().hasAll(['productId', 'title', 'price', 'purchasedAt'])
        && data.productId is string && data.productId.size() <= 128
        && data.title is string && data.title.size() <= 255
        && data.price is number
        && data.purchasedAt is timestamp;
    }

    match /users/{userId}/purchases/{purchaseId} {
      allow read, list: if isOwner(userId) && isValidId(userId);
      
      allow create: if isOwner(userId) && isValidId(userId) && isValidId(purchaseId)
        && exists(/databases/$(database)/documents/users/$(userId))
        && isValidPurchase(incoming())
        && incoming().purchasedAt == request.time;
      
      // Purchases are immutable once created
      allow update, delete: if false;
    }
  }
}
