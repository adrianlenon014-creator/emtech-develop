{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": ["email", "createdAt"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "A purchased digital good.",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 255
        },
        "price": {
          "type": "number"
        },
        "purchasedAt": {
          "type": "number"
        }
      },
      "required": ["productId", "title", "price", "purchasedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile document."
    },
    "users/{userId}/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/Purchase" },
      "description": "User purchases."
    }
  }
}
